{
  "name": "create-win-project",
  "version": "1.4.0",
  "description": "Project scaffolding CLI by Win",
  "main": "index.js",
  "type": "module",
  "bin": {
    "create-win-project": "./index.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/itsw1n/create-win-project.git"
  },
  "files": [
    "index.js",
    "src",
    "library",
    "templates",
    "checks",
    "public/logo.svg",
    "docs/ARCHITECTURE.md",
    "docs/CONTENT_MODEL.md",
    "docs/DEPENDENCY_MAINTENANCE.md",
    "docs/CONTRIBUTING.md",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "node index.js",
    "doctor": "node index.js doctor",
    "test": "vitest run",
    "validate:content": "node checks/check-library.js",
    "matrix:smoke": "node checks/check-compatibility.js --scope=smoke",
    "matrix:full": "node checks/check-compatibility.js --scope=full",
    "verify:generated": "node checks/check-generated-project.js"
  },
  "engines": {
    "node": ">=22.14",
    "npm": ">=11.19"
  },
  "dependencies": {
    "chalk": "5.6.2",
    "fs-extra": "11.4.0",
    "inquirer": "9.3.8",
    "ora": "7.0.1"
  },
  "devDependencies": {
    "vitest": "2.1.9"
  }
}

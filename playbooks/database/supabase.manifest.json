{
  "id": "supabase",
  "kind": "database",
  "label": "Supabase",
  "appliesTo": { "backend": ["supabase"] },
  "required": true,
  "makefileTemplate": "supabase",
  "folders": ["supabase/migrations"],
  "deps": ["@supabase/ssr", "@supabase/supabase-js"],
  "env": ["SUPABASE_URL", "SUPABASE_PUBLISHABLE_KEY"],
  "clientEnv": ["SUPABASE_URL", "SUPABASE_PUBLISHABLE_KEY"],
  "concerns": [
    { "id": "rls", "required": true, "playbook": "database/supabase.md", "sections": ["Row Level Security (RLS)", "Which Client to Use"] },
    { "id": "auth", "required": true, "playbook": "database/supabase.md", "sections": ["Supabase Auth Patterns"] }
  ]
}

{
  "id": "springboot",
  "kind": "backend",
  "label": "Spring Boot",
  "appliesTo": { "frontend": ["nextjs", "react", "react-native"] },
  "port": 8080,
  "needsDocker": true,
  "makefileTemplate": "springboot",
  "folders": [
    "backend/src/main/java/{{PACKAGE_PATH}}/config",
    "backend/src/main/java/{{PACKAGE_PATH}}/common/exception",
    "backend/src/main/java/{{PACKAGE_PATH}}/common/response",
    "backend/src/main/java/{{PACKAGE_PATH}}/common/audit",
    "backend/src/main/resources/db/migration",
    "backend/src/main/resources/db/dev",
    "backend/src/test/java/{{PACKAGE_PATH}}"
  ],
  "deps": {},
  "devDeps": {},
  "env": ["API_URL", "DATABASE_URL", "POSTGRES_USER", "POSTGRES_PASSWORD", "POSTGRES_DB", "SPRING_PROFILES_ACTIVE"],
  "clientEnv": ["API_URL"],
  "constraints": [
    "Spring Boot owns server-side business logic, authorization, and data access",
    "Security starts deny-by-default; add authentication through Spring Security rather than hand-rolled token code"
  ],
  "concerns": [
    { "id": "layers", "required": true, "playbook": "stack/springboot.md", "sections": ["Controller — HTTP Only", "Service — Business Logic Only", "Repository — DB Only"] },
    { "id": "security", "required": true, "playbook": "stack/springboot.md", "sections": ["Custom Auth Check in Service", "Bean Validation on Request DTOs"] }
  ]
}
